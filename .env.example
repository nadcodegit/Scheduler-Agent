# Leave MODEL and every *_API_KEY unset to run in fully offline/deterministic
# mode (regex classification + parsing, no network calls, no cost).
#
# To enable the real CrewAI LLM agents, set MODEL to a LiteLLM-style model
# string and the matching API key. Free options:
#
#   Groq (free tier, very fast, open models): https://console.groq.com/keys
#   Verified working as of 2026-08. Groq periodically retires model ids
#   (check https://console.groq.com/docs/deprecations if this stops working);
#   the smaller model is fine for this project's simple classify/extract
#   tasks, swap in openai/gpt-oss-120b for higher quality.
#     MODEL=groq/openai/gpt-oss-20b
#     GROQ_API_KEY=your_key_here
#
#   Google Gemini (free tier, no credit card): https://aistudio.google.com/apikey
#   As of 2026-08, AI Studio issues new keys in the "AQ." format, which is
#   mid-rollout and currently returns 401 ACCESS_TOKEN_TYPE_UNSUPPORTED for
#   many developers (see https://ai.google.dev/gemini-api/docs/api-key and
#   the Google AI Developers Forum). Try Groq first; revisit Gemini once
#   Google resolves this.
#     MODEL=gemini/gemini-2.0-flash
#     GEMINI_API_KEY=your_key_here
#
#   OpenAI (paid):
#     MODEL=gpt-4o-mini
#     OPENAI_API_KEY=your_key_here
MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# GROQ_API_KEY above is also used for roster-screenshot vision extraction
# (tools/roster_vision_tool.py), independent of MODEL -- that path is
# currently Groq-only (qwen/qwen3.6-27b) and has no other-provider fallback.

SCHEDULER_EMAIL=scheduler@example.com
USER_TIMEZONE=Asia/Yerevan

# V2's coverage-conflict check reads/writes outputs/approved_schedule.json --
# this project's own approved work schedule, not a real calendar (see the
# "Approved Schedule Store" section in README.md for why). No setup needed;
# it's seeded automatically from sample_data/sample_approved_schedule.json
# on first run.

