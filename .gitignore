.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
crewai_flow.html
# Generated invoices embed today's date, so they'd otherwise show a diff
# every time the V4 demo is re-run on a different day.
outputs/*.docx
# Accumulates real approved-schedule state across runs (seeded once from
# sample_data/sample_approved_schedule.json) -- not a fixed demo artifact.
outputs/approved_schedule.json
# A real Purchase Order PDF downloaded from Gmail -- may contain real
# personal/financial data, never a fixed demo artifact.
outputs/downloaded_purchase_order.pdf
# A real roster screenshot downloaded from Gmail -- contains real name/ID/
# schedule data, never a fixed demo artifact.
outputs/downloaded_roster_image.*
# Gmail OAuth client secret and cached user token -- never commit real
# credentials.
credentials.json
token.json
# Accumulates real run history from the scheduled/unattended check
# (scripts/run_scheduled_check.ps1) -- can include real email subjects/
# senders over time, never a fixed demo artifact.
outputs/scheduled_run.log
# Structured per-run history the desktop app's History tab reads -- same
# real-data-over-time reason as scheduled_run.log above.
outputs/run_history.jsonl
# Local Claude Code tooling config, not part of the project itself.
.claude/

